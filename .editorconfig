# Lua in this repo is two-space indented, LF, no trailing whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.lua]
max_line_length = 100

[Vendor/**]
# Upstream LibDeflate is vendored verbatim — do not reformat it.
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[*.md]
trim_trailing_whitespace = false

[*.toc]
end_of_line = lf
