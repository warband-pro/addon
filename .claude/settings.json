{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(luacheck .)",
      "Bash(luacheck:*)",
      "Bash(lua5.1:*)",
      "Bash(lua:*)",
      "Bash(node tools/validate.mjs)",
      "Bash(node tools/vector.mjs)",
      "Bash(node tools/vector.mjs --write)",
      "Bash(node tools/slop.mjs:*)",
      "Bash(node tools/notes.mjs:*)",
      "Bash(node tools/sample.mjs:*)",
      "Bash(node tools/changelog.mjs:*)",

      "Bash(apt-get update)",
      "Bash(apt-get install -y --no-install-recommends lua5.1 luarocks)",
      "Bash(apt-get install -y --no-install-recommends lua5.1)",
      "Bash(sudo apt-get update)",
      "Bash(sudo apt-get install -y --no-install-recommends lua5.1 luarocks)",
      "Bash(luarocks install luacheck)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote -v)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git restore --staged:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",

      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(node --version)",

      "mcp__github__get_me",
      "mcp__github__get_file_contents",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run",
      "mcp__github__list_releases",
      "mcp__github__get_latest_release",
      "mcp__github__list_tags",
      "mcp__github__search_code"
    ],
    "ask": [
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin v:*)",
      "mcp__github__actions_run_trigger"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/one-repo-per-commit.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
