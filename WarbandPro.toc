# Load order: vendor, then namespace, then data, then UI, then the dispatcher
# that wires them together. Core is last because it registers events at load.
Vendor\LibDeflate.lua
Init.lua
Store.lua
Scan.lua
Instances.lua
Bundle.lua
Export.lua
UI.lua
Core.lua
